# Modelo sem segredos. Configure valores reais apenas no ambiente privado.
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001
# Habilite somente após executar as duas migrações de segurança e configurar SMTP.
EMAIL_VERIFICATION_ENABLED=false

# JWT e HMAC: segredo aleatório de pelo menos 32 bytes. Não use estas linhas vazias em produção.
JWT_SECRET=
RATE_LIMIT_SECRET=

# Gmail por SMTP com senha de app; não é login OAuth do Google.
SMTP_SERVICE=gmail
SMTP_USER=portalarcadia.contato@gmail.com
SMTP_PASS=

DB_HOST=host
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true
DB_SSL_CA=

# Lembretes: desligados ate validar migracao, SMTP e agendamento de producao.
REMINDER_EMAIL_ENABLED=false
# Gere um segredo aleatorio com pelo menos 32 caracteres fora do chat.
CRON_SECRET=
# Migração PostgreSQL: permanece mysql até a conexão de Preview ser revisada.
DB_CLIENT=mysql
POSTGRES_URL=
POSTGRES_SSL=true
POSTGRES_SSL_CA=
# Não habilitar produção nesta etapa. A revisão do corte é separada.
ARCADIA_POSTGRES_PRODUCTION_APPROVED=false

# Ferramentas de transferência: credenciais separadas, nunca copiadas para o frontend.
# MYSQL_EXPORT_URL: conta MySQL somente leitura; não é preenchida a partir de DB_*.
MYSQL_EXPORT_URL=
MYSQL_EXPORT_SSL=true
MYSQL_EXPORT_SSL_CA=
# Conexão direta, sem -pooler e sem parâmetros SSL na URL; TLS é explícito.
POSTGRES_IMPORT_URL_DIRECT=
POSTGRES_IMPORT_SSL=true
POSTGRES_IMPORT_SSL_CA=
POSTGRES_IMPORT_BRANCH_ID=br-small-recipe-bblidqnf
POSTGRES_IMPORT_EXPECTED_HOST=
