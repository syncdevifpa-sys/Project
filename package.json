{
  "name": "syncdevifpa-sys",
  "version": "1.0.0",
  "private": true,
  "description": "SyncDev IFPA - Sistema de Mural Acadêmico e Portal do Estudante",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node backend/server.js",
    "build": "node tools/build-static.js",
    "prebuild": "npm run typebuild",
    "typecheck": "tsc -p tsconfig.tools.json --noEmit && tsc -p tsconfig.runtime.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "typebuild": "tsc -p tsconfig.tools.json && tsc -p tsconfig.runtime.json && tsc -p tsconfig.browser.json",
    "pretest": "npm run typebuild",
    "db:schema": "node tools/prepare-schema.js",
    "test": "node --test tests/*.test.js",
    "seed": "node tools/seed.js",
    "email:check": "node tools/check-email-setup.cjs",
    "db:migration:build": "node tools/db/build-migrations.cjs",
    "predb:migration:build": "npm run typebuild",
    "predb:workbench:build": "npm run typebuild",
    "db:workbench:build": "node tools/db/build-adoption.cjs && node tools/db/build-reminder-steps.cjs",
    "prestart": "npm run typebuild",
    "predev": "npm run typebuild"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "@vercel/functions": "^3.0.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "nodemailer": "10.1.2",
    "pdfjs-dist": "^6.4.299"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
