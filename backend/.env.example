# ==========================================
# Arcadia Backend - Variáveis de Ambiente
# ==========================================

PORT=3001
JWT_SECRET=sua_chave_secreta_jwt_longa_e_segura_aqui
APP_URL=http://localhost:3001

# ==========================================
# Google OAuth 2.0 (Google Cloud Console)
# ==========================================
# 1. Acesse https://console.cloud.google.com/
# 2. Crie um projeto e configure a Tela de Permissão OAuth
# 3. Crie credenciais do tipo "ID do cliente OAuth 2.0" -> Aplicativo Web
# 4. Adicione suas URIs de redirecionamento autorizadas (ex: http://localhost:3001, http://127.0.0.1:5501)
GOOGLE_CLIENT_ID=seu_google_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret_aqui

# ==========================================
# Banco de Dados (MySQL)
# ==========================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=arcadia

# ==========================================
# Serviço de E-mail (SMTP)
# ==========================================
# Opção A: Gmail (com Senha de App de 16 dígitos)
SMTP_SERVICE=gmail
SMTP_USER=arcadia.ifpa@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Opção B: Provedor SMTP Corporativo (Resend, SendGrid, Amazon SES, IFPA)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=Arcadia IFPA <contato@seudominio.edu.br>
