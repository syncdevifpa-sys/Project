# ==========================================
# Arcadia Backend - Variáveis de Ambiente
# ==========================================

PORT=3001
JWT_SECRET=sua_chave_secreta_jwt_longa_e_segura_aqui
APP_URL=http://localhost:3001

# ==========================================
# Google OAuth 2.0 (Google Cloud Console)
# ==========================================
# Crie um cliente OAuth do tipo Aplicativo Web no Google Auth Platform.
# Cadastre Origens JavaScript autorizadas, sem caminho (não são URLs de redirecionamento).
# Exemplos: http://localhost:3001 e https://portalarcadia.vercel.app
GOOGLE_CLIENT_ID=
# Origens extras do frontend, separadas por vírgula. APP_URL também é permitido.
GOOGLE_ALLOWED_ORIGINS=https://portalarcadia.vercel.app
# Este fluxo valida ID tokens: não utiliza Client Secret.

# ==========================================
# Banco de Dados (MySQL)
# ==========================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=arcadia

# ==========================================
# Serviço de E-mail (SMTP)
# ==========================================
# Opção A: Gmail (com Senha de App de 16 dígitos)
SMTP_SERVICE=gmail
SMTP_USER=arcadia.ifpa@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Opção B: Provedor SMTP Corporativo (Resend, SendGrid, Amazon SES, IFPA)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=Arcadia IFPA <contato@seudominio.edu.br>
