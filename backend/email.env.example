# Acrescente estes campos ao backend/.env existente; não substitua a configuração do banco.
# Não cole senhas na conversa. Este arquivo é um exemplo e não é carregado automaticamente.
APP_URL=http://localhost:3001
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
RATE_LIMIT_SECRET=
# Deixe false até aplicar migrações, configurar SMTP e conferir email:check.
EMAIL_VERIFICATION_ENABLED=false
