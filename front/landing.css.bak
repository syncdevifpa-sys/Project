/* ============================================================
   Arcádia — Landing page (style reference)
   Tokens, tipografia, navegação, hero, formas, seções, cards,
   rodapé. 1:1 com o PDF e .md de referência.
   ============================================================ */

:root {
  /* Colors */
  --color-tinta: #1d1d1f;
  --color-papel: #ffffff;
  --color-creme: #f7f4f2;
  --color-ceu-palido: #dceeff;
  --color-cinza-medio: #707070;
  --color-cinza-sobre-tinta: #a1a1a6;
  --color-borda-sutil: #3a3a3d;
  --color-acao-azul: #0071e3;
  --color-link-azul: #0066cc;
  --color-lima: #d2e534;
  --color-wisteria: #d8d1ff;
  --color-amarelo: #ffda00;
  --color-amarelo-quente: #ffe54d;
  --color-vermelho: #ff4141;
  --color-verde: #16ab59;
  --color-ceu: #91d8ec;
  --color-rosa: #ffbac4;
  --color-pessego: #f6e0db;

  /* Typography */
  --font-display: -apple-system, BlinkMacSystemFont, 'SF Pro Display', system-ui, sans-serif;
  --font-text: -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif;
  --font-mono: 'Martian Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

  --text-caption-mono: 12px;
  --tracking-caption-mono: -0.156px;
  --text-caption: 14px;
  --tracking-caption: -0.224px;
  --text-body: 17px;
  --leading-body: 1.47;
  --tracking-body: -0.374px;
  --text-body-lg: 21px;
  --leading-body-lg: 1.38;
  --tracking-body-lg: 0.231px;
  --text-lead: 24px;
  --tracking-lead: -0.2px;
  --text-heading-sm: 28px;
  --tracking-heading-sm: 0.196px;
  --text-heading: 42px;
  --tracking-heading: -0.378px;
  --text-heading-lg: 52px;
  --tracking-heading-lg: -0.468px;
  --text-display: clamp(58px, 9vw, 132px);
  --leading-display: 1.05;
  --tracking-display: -0.015em;
  --text-number: 62px;
  --tracking-number: -0.558px;

  --font-weight-regular: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;

  /* Spacing */
  --spacing-4: 4px;
  --spacing-8: 8px;
  --spacing-12: 12px;
  --spacing-16: 16px;
  --spacing-20: 20px;
  --spacing-24: 24px;
  --spacing-28: 28px;
  --spacing-32: 32px;
  --spacing-48: 48px;
  --spacing-56: 56px;
  --spacing-88: 88px;
  --spacing-96: 96px;
  --spacing-100: 100px;

  /* Layout */
  --page-max-width: 1200px;
  --section-padding-y: 96px;
  --card-padding: 28px;
  --element-gap: 16px;

  /* Border Radius */
  --radius-image: 16px;
  --radius-cards: 28px;
  --radius-badges: 36px;
  --radius-buttons: 980px;
  --radius-inputs: 980px;
  --radius-shapes: 0px;
  --radius-circle: 5000px;

  /* Borders */
  --border-ink: 2px solid #1d1d1f;
  --border-paper: 2px solid #ffffff;

  /* Surfaces */
  --surface-creme: #f7f4f2;
  --surface-papel: #ffffff;
  --surface-ceu-palido: #dceeff;
  --surface-lima: #d2e534;
  --surface-wisteria: #d8d1ff;
  --surface-tinta: #1d1d1f;
}

/* ============================================================
   RESET
   ============================================================ */

* { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

body {
  font-family: var(--font-text);
  background: var(--surface-creme);
  color: var(--color-tinta);
  font-size: var(--text-body);
  line-height: var(--leading-body);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

a { color: inherit; text-decoration: none; }
ul { list-style: none; }

.container {
  max-width: var(--page-max-width);
  margin: 0 auto;
  padding-left: var(--spacing-24);
  padding-right: var(--spacing-24);
}

/* ============================================================
   NAVEGAÇÃO — pílula branca, borda 2px tinta
   ============================================================ */

.nav {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--surface-papel);
  border-bottom: var(--border-ink);
}

.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-24);
  padding: var(--spacing-20) 0;
  max-width: var(--page-max-width);
  margin: 0 auto;
  padding-left: var(--spacing-24);
  padding-right: var(--spacing-24);
}

.nav-logo {
  display: flex;
  align-items: center;
  gap: var(--spacing-12);
  font-family: var(--font-display);
  font-size: var(--text-heading-sm);
  font-weight: var(--font-weight-bold);
  letter-spacing: var(--tracking-heading-sm);
  color: var(--color-tinta);
  text-decoration: none;
}

.nav-badge {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-buttons);
  background: var(--color-wisteria);
  border: var(--border-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: var(--font-weight-bold);
  color: var(--color-tinta);
  flex-shrink: 0;
}

.nav-links {
  display: flex;
  gap: var(--spacing-12);
}

.nav-links a {
  font-size: var(--text-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-tinta);
  background: var(--surface-papel);
  border: var(--border-ink);
  border-radius: var(--radius-buttons);
  padding: 9px 18px;
  transition: background 0.15s ease;
}

.nav-links a:hover { background: var(--surface-creme); }

.nav-actions {
  display: flex;
  align-items: center;
  gap: var(--spacing-12);
}

/* ============================================================
   BOTÕES — pílula primária azul, pílula secundária branca
   ============================================================ */

.btn {
  display: inline-flex;
  align-items: center;
  gap: var(--spacing-8);
  font-family: var(--font-text);
  font-size: var(--text-body);
  font-weight: var(--font-weight-medium);
  border-radius: var(--radius-buttons);
  padding: 12px 22px;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  text-decoration: none;
}

.btn-primary {
  background: var(--color-acao-azul);
  color: var(--color-papel);
  border: var(--border-ink);
}

.btn-primary:hover { background: #0066cc; }
.btn-primary::after { content: '→'; }

.btn-secondary {
  background: var(--surface-papel);
  color: var(--color-tinta);
  border: var(--border-ink);
}

.btn-secondary:hover { background: var(--surface-creme); }

.btn-ghost-dark {
  background: transparent;
  color: var(--color-papel);
  border: var(--border-paper);
}

.btn-ghost-dark:hover {
  background: var(--surface-tinta);
  color: var(--color-papel);
}

/* ============================================================
   FORMAS DECORATIVAS — camada base (clip-path, clamp, rotação)
   ============================================================ */

.shape {
  position: absolute;
  overflow: hidden;
  pointer-events: none;
  z-index: -1;
}

.shape--circle {
  border-radius: var(--radius-circle);
}

.shape--polygon {
  border-radius: var(--radius-shapes);
  clip-path: polygon(50% 0%, 100% 30%, 100% 70%, 50% 100%, 0% 70%, 0% 30%);
}

.shape--pentagon {
  border-radius: var(--radius-shapes);
  clip-path: polygon(50% 0%, 100% 38%, 82% 100%, 18% 100%, 0% 38%);
}

.shape--triangle {
  border-radius: var(--radius-shapes);
  clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
}

.shape--star {
  border-radius: var(--radius-shapes);
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}

.shape--semi {
  border-radius: var(--radius-shapes);
  clip-path: polygon(0% 100%, 100% 100%, 100% 0%, 50% 50%, 0% 0%);
}

.shape--parallelogram {
  border-radius: var(--radius-shapes);
  clip-path: polygon(20% 0%, 80% 0%, 100% 50%, 80% 100%, 20% 100%, 0% 50%);
}

/* ============================================================
   HERO — canvas céu pálido
   ============================================================ */

.hero {
  background: var(--surface-ceu-palido);
  overflow: hidden;
  padding: var(--spacing-96) 0;
  position: relative;
}

.hero-inner {
  position: relative;
  z-index: 1;
  max-width: var(--page-max-width);
  margin: 0 auto;
  padding-left: var(--spacing-24);
  padding-right: var(--spacing-24);
  text-align: center;
}

/* 8 formas chapadas na hero */

.hero-shape-1 {
  width: clamp(110px, 18vw, 320px);
  height: clamp(110px, 18vw, 320px);
  background: var(--color-amarelo);
  top: 20px;
  right: -60px;
  transform: rotate(10deg);
}

.hero-shape-2 {
  width: clamp(110px, 20vw, 420px);
  height: clamp(110px, 20vw, 420px);
  background: var(--color-verde);
  bottom: -60px;
  left: -80px;
  transform: rotate(12deg);
}

.hero-shape-3 {
  width: clamp(110px, 14vw, 260px);
  height: clamp(110px, 14vw, 260px);
  background: var(--color-amarelo-quente);
  top: 40px;
  right: 10%;
  transform: rotate(-16deg);
}

.hero-shape-4 {
  width: clamp(110px, 12vw, 220px);
  height: clamp(110px, 12vw, 220px);
  background: var(--color-ceu);
  bottom: 30px;
  left: 20%;
  transform: rotate(8deg);
}

.hero-shape-5 {
  width: clamp(110px, 22vw, 380px);
  height: clamp(110px, 22vw, 380px);
  background: var(--color-vermelho);
  top: 20px;
  left: -100px;
  transform: rotate(-10deg);
}

.hero-shape-6 {
  width: clamp(110px, 16vw, 300px);
  height: clamp(110px, 16vw, 300px);
  background: var(--color-rosa);
  bottom: -40px;
  right: 5%;
  transform: rotate(15deg);
}

.hero-shape-7 {
  width: clamp(110px, 13vw, 250px);
  height: clamp(110px, 13vw, 250px);
  background: var(--color-amarelo);
  top: 60px;
  left: 55%;
  transform: rotate(-5deg);
}

.hero-shape-8 {
  width: clamp(110px, 15vw, 280px);
  height: clamp(110px, 15vw, 280px);
  background: var(--color-verde);
  bottom: 60px;
  left: -60px;
  transform: rotate(-14deg);
}

/* Badge da marca (wisteria, 56px) */

.hero-badge {
  width: 56px;
  height: 56px;
  border-radius: var(--radius-buttons);
  background: var(--color-wisteria);
  border: var(--border-ink);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 24px;
  font-weight: var(--font-weight-bold);
  color: var(--color-tinta);
  margin-bottom: var(--spacing-16);
}

/* Título hero */

.hero-title {
  font-family: var(--font-display);
  font-size: var(--text-display);
  font-weight: var(--font-weight-bold);
  line-height: var(--leading-display);
  letter-spacing: var(--tracking-display);
  text-align: center;
  color: var(--color-tinta);
  margin-bottom: var(--spacing-16);
}

.hero-title-secondary {
  display: block;
}

/* Subtítulo */

.hero-subtitle {
  font-family: var(--font-text);
  font-size: var(--text-lead);
  line-height: 1.4;
  letter-spacing: var(--tracking-lead);
  text-align: center;
  color: var(--color-tinta);
  max-width: 48ch;
  margin: 0 auto var(--spacing-48);
}

/* Par de botões hero */

.hero-cta {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--spacing-16);
  margin-bottom: var(--spacing-56);
}

/* Painel branco 1000px com 3 avisos */

.hero-panel {
  background: var(--surface-papel);
  border: var(--border-ink);
  border-radius: var(--radius-cards);
  padding: var(--spacing-28);
  max-width: 1000px;
  margin: 0 auto;
  display: grid;
  gap: var(--spacing-24);
}

.hero-panel-row {
  display: flex;
  gap: var(--spacing-16);
  align-items: flex-start;
  background: var(--surface-creme);
  border: var(--border-ink);
  border-radius: var(--radius-cards);
}

.hero-color-block {
  width: 120px;
  height: 120px;
  border-radius: var(--radius-image);
  flex-shrink: 0;
  display: inline-block;
}

.hero-notice-meta {
  font-family: var(--font-mono);
  font-size: var(--text-caption-mono);
  line-height: 1.35;
  letter-spacing: var(--tracking-caption-mono);
  color: var(--color-cinza-medio);
  text-transform: uppercase;
  margin-bottom: var(--spacing-8);
}

.hero-notice-title {
  font-family: var(--font-text);
  font-size: var(--text-heading-sm);
  font-weight: var(--font-weight-semibold);
  line-height: 1.14;
  letter-spacing: var(--tracking-heading-sm);
  color: var(--color-tinta);
  margin-bottom: var(--spacing-8);
}

.hero-notice-summary {
  font-family: var(--font-text);
  font-size: var(--text-body);
  line-height: var(--leading-body);
  letter-spacing: var(--tracking-body);
  color: var(--color-tinta);
  margin-bottom: var(--spacing-12);
}

.hero-panel-link {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-text);
  font-size: var(--text-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-tinta);
  background: var(--color-acao-azul);
  border: var(--border-ink);
  border-radius: var(--radius-buttons);
  padding: 12px 22px;
  text-decoration: none;
  transition: background 0.15s ease;
}

.hero-panel-link:hover { background: #0066cc; }
.hero-panel-link::after { content: '→'; }

/* ============================================================
   FAIXA DE CATEGORIAS — banda branca entre 2px
   ============================================================ */

.category-strip {
  background: var(--surface-papel);
  border-top: var(--border-ink);
  border-bottom: var(--border-ink);
  padding: var(--spacing-16) 0;
  margin-top: var(--spacing-48);
}

.category-strip-inner {
  display: flex;
  justify-content: center;
  gap: var(--spacing-16);
  flex-wrap: wrap;
  max-width: var(--page-max-width);
  margin: 0 auto;
  padding-left: var(--spacing-24);
  padding-right: var(--spacing-24);
}

.category-pill {
  font-family: var(--font-text);
  font-size: var(--text-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-tinta);
  background: var(--surface-papel);
  border: var(--border-ink);
  border-radius: var(--radius-badges);
  padding: 5px 14px;
}

/* ============================================================
   SEÇÃO DE NÚMEROS — sala lima
   ============================================================ */

.numbers {
  background: var(--surface-lima);
  overflow: hidden;
  padding: var(--section-padding-y) var(--spacing-24);
  position: relative;
}

.numbers-inner {
  position: relative;
  z-index: 1;
  max-width: var(--page-max-width);
  margin: 0 auto;
}

.numbers-eyebrow {
  font-family: var(--font-mono);
  font-size: var(--text-caption-mono);
  line-height: 1.35;
  letter-spacing: var(--tracking-caption-mono);
  color: var(--color-tinta);
  text-transform: uppercase;
  margin-bottom: var(--spacing-12);
}

.numbers-title {
  font-family: var(--font-display);
  font-size: var(--text-heading);
  font-weight: var(--font-weight-bold);
  line-height: 1.1;
  letter-spacing: var(--tracking-heading);
  color: var(--color-tinta);
  max-width: 40ch;
  margin-bottom: var(--spacing-48);
}

.numbers-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--spacing-24);
}

.numbers-card {
  background: var(--surface-papel);
  border: var(--border-ink);
  border-radius: var(--radius-cards);
  padding: var(--card-padding);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-16);
}

.numbers-card-eyebrow {
  font-family: var(--font-mono);
  font-size: var(--text-caption-mono);
  line-height: 1.35;
  letter-spacing: var(--tracking-caption-mono);
  color: var(--color-cinza-medio);
  text-transform: uppercase;
}

.numbers-card-value {
  font-family: var(--font-display);
  font-size: var(--text-number);
  font-weight: var(--font-weight-bold);
  line-height: 1.05;
  letter-spacing: var(--tracking-number);
  color: var(--color-tinta);
}

.numbers-card-label {
  font-family: var(--font-text);
  font-size: var(--text-body-lg);
  line-height: var(--leading-body-lg);
  letter-spacing: var(--tracking-body-lg);
  color: var(--color-tinta);
  max-width: 26ch;
}

/* Decorative shapes na sala lima (3 unidades) */

.numbers-shape-1 {
  width: clamp(110px, 18vw, 300px);
  height: clamp(110px, 18vw, 300px);
  background: var(--color-amarelo);
  top: -60px;
  right: -50px;
  transform: rotate(-10deg);
}

.numbers-shape-2 {
  width: clamp(110px, 14vw, 240px);
  height: clamp(110px, 14vw, 240px);
  background: var(--color-vermelho);
  bottom: -50px;
  left: -40px;
  transform: rotate(14deg);
}

.numbers-shape-3 {
  width: clamp(110px, 12vw, 200px);
  height: clamp(110px, 12vw, 200px);
  background: var(--color-rosa);
  top: 30px;
  left: 30%;
  transform: rotate(-6deg);
}

/* ============================================================
   SEÇÃO MURAL — sala tinta
   ============================================================ */

.mural {
  background: var(--surface-tinta);
  overflow: hidden;
  padding: var(--section-padding-y) var(--spacing-24);
  position: relative;
}

.mural-inner {
  position: relative;
  z-index: 1;
  max-width: var(--page-max-width);
  margin: 0 auto;
}

.mural-eyebrow {
  font-family: var(--font-mono);
  font-size: var(--text-caption-mono);
  line-height: 1.35;
  letter-spacing: var(--tracking-caption-mono);
  color: var(--color-papel);
  text-transform: uppercase;
  margin-bottom: var(--spacing-12);
}

.mural-title {
  font-family: var(--font-display);
  font-size: var(--text-heading);
  font-weight: var(--font-weight-bold);
  line-height: 1.1;
  letter-spacing: var(--tracking-heading);
  color: var(--color-papel);
  max-width: 40ch;
  margin-bottom: var(--spacing-16);
}

.mural-lead {
  font-family: var(--font-text);
  font-size: var(--text-body-lg);
  line-height: var(--leading-body-lg);
  letter-spacing: var(--tracking-body-lg);
  color: var(--color-cinza-sobre-tinta);
  max-width: 48ch;
  margin-bottom: var(--spacing-48);
}

.mural-shape-1 {
  width: clamp(110px, 18vw, 300px);
  height: clamp(110px, 18vw, 300px);
  background: var(--color-amarelo);
  top: -60px;
  right: -50px;
  transform: rotate(-14deg);
}

.mural-shape-2 {
  width: clamp(110px, 20vw, 380px);
  height: clamp(110px, 20vw, 380px);
  background: var(--color-ceu);
  bottom: -50px;
  left: -60px;
  transform: rotate(10deg);
}

.mural-shape-3 {
  width: clamp(110px, 14vw, 240px);
  height: clamp(110px, 14vw, 240px);
  background: var(--color-vermelho);
  top: 20px;
  left: 20%;
  transform: rotate(-8deg);
}

/* Filtro wisteria */

.filter-section {
  background: var(--surface-wisteria);
  overflow: hidden;
  padding: var(--spacing-20) 0;
  margin-bottom: var(--spacing-48);
  border-top: var(--border-ink);
  border-bottom: var(--border-ink);
}

.filter-inner {
  max-width: var(--page-max-width);
  margin: 0 auto;
  padding-left: var(--spacing-24);
  padding-right: var(--spacing-24);
}

.filter-label {
  font-family: var(--font-mono);
  font-size: var(--text-caption-mono);
  line-height: 1.35;
  letter-spacing: var(--tracking-caption-mono);
  color: var(--color-tinta);
  text-transform: uppercase;
  margin-bottom: var(--spacing-16);
}

.filter-chips {
  display: flex;
  gap: var(--spacing-12);
  flex-wrap: wrap;
}

.filter-group {
  margin-bottom: var(--spacing-24);
}

.filter-chip {
  font-family: var(--font-text);
  font-size: var(--text-body);
  font-weight: var(--font-weight-medium);
  border-radius: var(--radius-buttons);
  padding: 9px 20px;
  border: var(--border-ink);
  background: var(--surface-papel) !important;
  color: var(--color-tinta);
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}

.filter-chip.active {
  background: var(--color-lima) !important;
  color: var(--color-tinta);
}

/* Lista de avisos */

.mural-list-section {
  background: var(--surface-wisteria);
  overflow: hidden;
  padding: var(--section-padding-y) var(--spacing-24);
  position: relative;
}

.mural-list-inner {
  position: relative;
  z-index: 1;
  max-width: var(--page-max-width);
  margin: 0 auto;
}

.mural-list {
  display: grid;
  gap: var(--spacing-24);
}

.aviso-card {
  background: var(--surface-papel);
  border: var(--border-ink);
  border-radius: var(--radius-cards);
  padding: var(--card-padding);
  display: flex;
  gap: var(--spacing-16);
  align-items: flex-start;
}

.aviso-color-block {
  width: 120px;
  border-radius: var(--radius-image);
  flex-shrink: 0;
}

.aviso-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-12);
}

.aviso-meta {
  font-family: var(--font-mono);
  font-size: var(--text-caption-mono);
  line-height: 1.35;
  letter-spacing: var(--tracking-caption-mono);
  color: var(--color-cinza-medio);
  text-transform: uppercase;
}

.aviso-meta-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-12);
  margin-bottom: var(--spacing-8);
}

.aviso-meta-row .aviso-meta { margin-bottom: 0; }

.aviso-title {
  font-family: var(--font-text);
  font-size: var(--text-heading-sm);
  font-weight: var(--font-weight-semibold);
  line-height: 1.14;
  letter-spacing: var(--tracking-heading-sm);
  color: var(--color-tinta);
}
}

.aviso-category-pill {
  font-family: var(--font-text);
  font-size: var(--text-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-tinta);
  background: var(--surface-papel);
  border: var(--border-ink);
  border-radius: var(--radius-badges);
  padding: 5px 14px;
}

.aviso-title {
  font-family: var(--font-text);
  font-size: var(--text-heading-sm);
  font-weight: var(--font-weight-semibold);
  line-height: 1.14;
  letter-spacing: var(--tracking-heading-sm);
  color: var(--color-tinta);
}

.aviso-summary {
  font-family: var(--font-text);
  font-size: var(--text-body);
  line-height: var(--leading-body);
  letter-spacing: var(--tracking-body);
  color: var(--color-tinta);
  margin-bottom: var(--spacing-12);
}

.aviso-link {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-text);
  font-size: var(--text-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-tinta);
  background: var(--color-acao-azul);
  border: var(--border-ink);
  border-radius: var(--radius-buttons);
  padding: 12px 22px;
  text-decoration: none;
  transition: background 0.15s ease;
}

.aviso-link:hover { background: #0066cc; }
.aviso-link::after { content: '→'; }

/* ============================================================
   SEÇÃO DOCUMENTOS — sala creme
   ============================================================ */

.documents {
  background: var(--surface-creme);
  overflow: hidden;
  padding: var(--section-padding-y) var(--spacing-24);
  position: relative;
}

.documents-inner {
  position: relative;
  z-index: 1;
  max-width: var(--page-max-width);
  margin: 0 auto;
}

.documents-eyebrow {
  font-family: var(--font-mono);
  font-size: var(--text-caption-mono);
  line-height: 1.35;
  letter-spacing: var(--tracking-caption-mono);
  color: var(--color-cinza-medio);
  text-transform: uppercase;
  margin-bottom: var(--spacing-12);
}

.documents-title {
  font-family: var(--font-display);
  font-size: var(--text-heading);
  font-weight: var(--font-weight-bold);
  line-height: 1.1;
  letter-spacing: var(--tracking-heading);
  color: var(--color-tinta);
  max-width: 40ch;
  margin-bottom: var(--spacing-16);
}

.documents-lead {
  font-family: var(--font-text);
  font-size: var(--text-body-lg);
  line-height: var(--leading-body-lg);
  letter-spacing: var(--tracking-body-lg);
  color: var(--color-tinta);
  max-width: 48ch;
  margin-bottom: var(--spacing-48);
}

.documents-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--spacing-24);
}

.document-card {
  background: var(--surface-papel);
  border: var(--border-ink);
  border-radius: var(--radius-cards);
  padding: var(--card-padding);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-16);
}

.document-type {
  font-family: var(--font-mono);
  font-size: var(--text-caption-mono);
  line-height: 1.35;
  letter-spacing: var(--tracking-caption-mono);
  color: var(--color-cinza-medio);
  text-transform: uppercase;
}

.document-summary {
  font-family: var(--font-text);
  font-size: var(--text-body);
  line-height: var(--leading-body);
  letter-spacing: var(--tracking-body);
  color: var(--color-tinta);
  margin-bottom: var(--spacing-12);
}

.document-title {
  font-family: var(--font-text);
  font-size: var(--text-heading-sm);
  font-weight: var(--font-weight-semibold);
  line-height: 1.14;
  letter-spacing: var(--tracking-heading-sm);
  color: var(--color-tinta);
}

.document-link {
  display: inline-flex;
  align-items: center;
  font-family: var(--font-text);
  font-size: var(--text-body);
  font-weight: var(--font-weight-medium);
  color: var(--color-tinta);
  background: var(--color-acao-azul);
  border: var(--border-ink);
  border-radius: var(--radius-buttons);
  padding: 12px 22px;
  text-decoration: none;
  align-self: flex-start;
  transition: background 0.15s ease;
  margin-top: auto;
}

.document-link:hover { background: #0066cc; }
.document-link::after { content: '→'; }

.documents-shape-1 {
  width: clamp(110px, 16vw, 260px);
  height: clamp(110px, 16vw, 260px);
  background: var(--color-amarelo-quente);
  top: -60px;
  left: -50px;
  transform: rotate(12deg);
}

.documents-shape-2 {
  width: clamp(110px, 14vw, 240px);
  height: clamp(110px, 14vw, 240px);
  background: var(--color-verde);
  bottom: -50px;
  right: -40px;
  transform: rotate(-10deg);
}

.documents-shape-3 {
  width: clamp(110px, 12vw, 200px);
  height: clamp(110px, 12vw, 200px);
  background: var(--color-rosa);
  top: 20px;
  left: 40%;
  transform: rotate(-6deg);
}

/* ============================================================
   SEÇÃO PROJETOS — sala tinta
   ============================================================ */

.projects {
  background: var(--surface-tinta);
  overflow: hidden;
  padding: var(--section-padding-y) var(--spacing-24);
  position: relative;
}

.projects-inner {
  position: relative;
  z-index: 1;
  max-width: var(--page-max-width);
  margin: 0 auto;
}

.projects-eyebrow {
  font-family: var(--font-mono);
  font-size: var(--text-caption-mono);
  line-height: 1.35;
  letter-spacing: var(--tracking-caption-mono);
  color: var(--color-papel);
  text-transform: uppercase;
  margin-bottom: var(--spacing-12);
}

.projects-title {
  font-family: var(--font-display);
  font-size: var(--text-heading);
  font-weight: var(--font-weight-bold);
  line-height: 1.1;
  letter-spacing: var(--tracking-heading);
  color: var(--color-papel);
  max-width: 40ch;
  margin-bottom: var(--spacing-16);
}

.projects-lead {
  font-family: var(--font-text);
  font-size: var(--text-body-lg);
  line-height: var(--leading-body-lg);
  letter-spacing: var(--tracking-body-lg);
  color: var(--color-cinza-sobre-tinta);
  max-width: 48ch;
  margin-bottom: var(--spacing-48);
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--spacing-24);
}

.project-card {
  background: var(--surface-tinta);
  border: var(--border-paper);
  border-radius: var(--radius-cards);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.project-color-block {
  height: 200px;
  flex-shrink: 0;
}

.project-body {
  padding: var(--spacing-24);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-8);
}

.project-axis {
  font-family: var(--font-mono);
  font-size: var(--text-caption-mono);
  line-height: 1.35;
  letter-spacing: var(--tracking-caption-mono);
  color: var(--color-ceu);
  text-transform: uppercase;
}

.project-title {
  font-family: var(--font-text);
  font-size: var(--text-body-lg);
  font-weight: var(--font-weight-semibold);
  line-height: 1.14;
  letter-spacing: var(--tracking-heading-sm);
  color: var(--color-papel);
}

.project-author {
  font-family: var(--font-text);
  font-size: var(--text-body);
  line-height: var(--leading-body);
  letter-spacing: var(--tracking-body);
  color: var(--color-cinza-sobre-tinta);
}

.projects-shape-1 {
  width: clamp(110px, 18vw, 300px);
  height: clamp(110px, 18vw, 300px);
  background: var(--color-amarelo);
  top: -60px;
  right: -50px;
  transform: rotate(14deg);
}

.projects-shape-2 {
  width: clamp(110px, 16vw, 280px);
  height: clamp(110px, 16vw, 280px);
  background: var(--color-ceu);
  bottom: -50px;
  left: -60px;
  transform: rotate(-12deg);
}

.projects-shape-3 {
  width: clamp(110px, 12vw, 200px);
  height: clamp(110px, 12vw, 200px);
  background: var(--color-vermelho);
  top: 20px;
  left: 15%;
  transform: rotate(-8deg);
}

/* Número de avisos (3 pilhas horizontais) */

.mural-list-count {
  display: flex;
  gap: var(--spacing-12);
  margin-bottom: var(--spacing-48);
}

.mural-list-count-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-8);
}

.mural-list-count-number {
  font-family: var(--font-display);
  font-size: var(--text-number);
  font-weight: var(--font-weight-bold);
  line-height: 1.05;
  letter-spacing: var(--tracking-number);
  color: var(--color-papel);
}

.mural-list-count-label {
  font-family: var(--font-mono);
  font-size: var(--text-caption-mono);
  line-height: 1.35;
  letter-spacing: var(--tracking-caption-mono);
  color: var(--color-cinza-sobre-tinta);
  text-transform: uppercase;
}

/* ============================================================
   SEÇÃO CTA FINAL — sala tinta
   ============================================================ */

.cta-final {
  background: var(--surface-tinta);
  overflow: hidden;
  padding: var(--section-padding-y) var(--spacing-24);
  position: relative;
}

.cta-final-inner {
  position: relative;
  z-index: 1;
  max-width: var(--page-max-width);
  margin: 0 auto;
}

.cta-final-title {
  font-family: var(--font-display);
  font-size: var(--text-heading-lg);
  font-weight: var(--font-weight-bold);
  line-height: 1.1;
  letter-spacing: var(--tracking-heading-lg);
  color: var(--color-papel);
  max-width: 30ch;
  margin-bottom: var(--spacing-16);
}

.cta-final-lead {
  font-family: var(--font-text);
  font-size: var(--text-body-lg);
  line-height: var(--leading-body-lg);
  letter-spacing: var(--tracking-body-lg);
  color: var(--color-cinza-sobre-tinta);
  max-width: 48ch;
  margin-bottom: var(--spacing-48);
}

.cta-final-actions {
  display: flex;
  gap: var(--spacing-12);
  flex-wrap: wrap;
  margin-bottom: var(--spacing-56);
}

.cta-final-stats {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-48);
  padding-top: var(--spacing-24);
  border-top: var(--border-paper);
}

.cta-stat-value {
  font-family: var(--font-display);
  font-size: var(--text-number);
  font-weight: var(--font-weight-bold);
  line-height: 1.05;
  letter-spacing: var(--tracking-number);
  color: var(--color-papel);
}

.cta-stat-label {
  font-family: var(--font-text);
  font-size: var(--text-body-lg);
  line-height: var(--leading-body-lg);
  letter-spacing: var(--tracking-body-lg);
  color: var(--color-cinza-sobre-tinta);
  max-width: 26ch;
  margin-top: var(--spacing-8);
}

.cta-final-shape-1 {
  width: clamp(110px, 18vw, 300px);
  height: clamp(110px, 18vw, 300px);
  background: var(--color-amarelo);
  top: -60px;
  left: -50px;
  transform: rotate(10deg);
}

.cta-final-shape-2 {
  width: clamp(110px, 16vw, 280px);
  height: clamp(110px, 16vw, 280px);
  background: var(--color-verde);
  bottom: -50px;
  right: -60px;
  transform: rotate(-14deg);
}

.cta-final-shape-3 {
  width: clamp(110px, 12vw, 200px);
  height: clamp(110px, 12vw, 200px);
  background: var(--color-rosa);
  top: 20px;
  right: 10%;
  transform: rotate(-6deg);
}

/* ============================================================
   RODAPÉ — sala tinta
   ============================================================ */

.footer {
  background: var(--surface-tinta);
  overflow: hidden;
  padding: var(--spacing-88) var(--spacing-24) var(--spacing-32);
  position: relative;
}

.footer-inner {
  position: relative;
  z-index: 1;
  max-width: var(--page-max-width);
  margin: 0 auto;
}

.footer-brand {
  margin-bottom: var(--spacing-56);
  max-width: 400px;
}

.footer-badge {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-buttons);
  background: var(--color-wisteria);
  border: var(--border-ink);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 22px;
  font-weight: var(--font-weight-bold);
  color: var(--color-tinta);
  margin-bottom: var(--spacing-16);
}

.footer-wordmark {
  font-family: var(--font-display);
  font-size: 32px;
  font-weight: var(--font-weight-bold);
  letter-spacing: var(--tracking-heading-lg);
  color: var(--color-papel);
  margin-bottom: var(--spacing-8);
}

.footer-summary {
  font-family: var(--font-text);
  font-size: var(--text-body-lg);
  line-height: var(--leading-body-lg);
  letter-spacing: var(--tracking-body-lg);
  color: var(--color-cinza-sobre-tinta);
  max-width: 36ch;
  margin-bottom: var(--spacing-24);
}

.footer-actions {
  display: flex;
  gap: var(--spacing-12);
  flex-wrap: wrap;
}

.footer-links {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: var(--spacing-48);
  padding-top: var(--spacing-48);
  border-top: var(--border-sutil);
  margin-bottom: var(--spacing-24);
}

.footer-link-col {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-8);
}

.footer-link-label {
  font-family: var(--font-mono);
  font-size: var(--text-caption-mono);
  line-height: 1.35;
  letter-spacing: var(--tracking-caption-mono);
  color: var(--color-papel);
  text-transform: uppercase;
  margin-bottom: var(--spacing-4);
}

.footer-link {
  font-family: var(--font-text);
  font-size: var(--text-body);
  line-height: var(--leading-body);
  letter-spacing: var(--tracking-body);
  color: var(--color-cinza-sobre-tinta);
}

.footer-divider {
  border-top: var(--border-sutil);
  margin-bottom: var(--spacing-24);
}

.footer-legal {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-16);
  font-size: var(--text-caption);
}

.footer-institution {
  font-family: var(--font-mono);
  font-size: var(--text-caption-mono);
  line-height: 1.35;
  letter-spacing: var(--tracking-caption-mono);
  color: var(--color-papel);
  text-transform: uppercase;
}

.footer-note {
  font-family: var(--font-text);
  font-size: var(--text-caption);
  line-height: var(--leading-body);
  letter-spacing: var(--tracking-caption);
  color: var(--color-cinza-sobre-tinta);
}

.footer-shape-1 {
  width: clamp(110px, 18vw, 300px);
  height: clamp(110px, 18vw, 300px);
  background: var(--color-amarelo);
  top: -80px;
  left: -60px;
  transform: rotate(12deg);
}

.footer-shape-2 {
  width: clamp(110px, 16vw, 280px);
  height: clamp(110px, 16vw, 280px);
  background: var(--color-verde);
  bottom: -60px;
  right: -80px;
  transform: rotate(-10deg);
}

.footer-shape-3 {
  width: clamp(110px, 14vw, 240px);
  height: clamp(110px, 14vw, 240px);
  background: var(--color-rosa);
  top: 20px;
  right: -50px;
  transform: rotate(-8deg);
}

/* ============================================================
   RESPONSIVO — formas escondidas abaixo de 600px
   ============================================================ */

@media (max-width: 600px) {
  .hero-shape-1, .hero-shape-2, .hero-shape-3, .hero-shape-4,
  .hero-shape-5, .hero-shape-6, .hero-shape-7, .hero-shape-8,
  .numbers-shape-1, .numbers-shape-2, .numbers-shape-3,
  .mural-shape-1, .mural-shape-2, .mural-shape-3,
  .documents-shape-1, .documents-shape-2, .documents-shape-3,
  .projects-shape-1, .projects-shape-2, .projects-shape-3,
  .cta-final-shape-1, .cta-final-shape-2, .cta-final-shape-3,
  .footer-shape-1, .footer-shape-2, .footer-shape-3 {
    display: none;
  }
}
